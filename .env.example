# Copy this file to ".env" and change the values. Never commit ".env".

# Port the server listens on
PORT=3000

# First admin (teacher) account. It is created when the server starts if it does not exist yet.
# Public sign-up only ever creates student accounts, so you need this to post announcements.
ADMIN_NAME=Admin Teacher
ADMIN_EMAIL=teacher@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Where users, sessions and announcements are saved (relative to the project folder)
# DATA_FILE=data/db.json

# Days a login lasts
# SESSION_DAYS=7

# Production only:
# NODE_ENV=production      -> the login cookie is sent over HTTPS only
# COOKIE_SECURE=false      -> set this if you run production mode over plain http
# TRUST_PROXY=1            -> set when running behind a reverse proxy such as nginx
